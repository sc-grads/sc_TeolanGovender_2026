                    <ExpressionTask
                      Expression="(LOWER(LEFT(@[User::SheetName], 3)) == LOWER(LEFT(@[User::FileMonth], 3))) || (LOWER(@[User::FileMonth]) == &quot;march&quot; &amp;&amp; LOWER(LEFT(@[User::SheetName], 3)) == &quot;mar&quot;)" />
