                              description="Specifies a SQL statement that uses parameters to generate the lookup table."
                              expressionType="Notify"
                              name="SqlCommandParam"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select * from (SELECT ConsultantID, FirstName FROM dbo.Consultants) [refTable]
where [refTable].[FirstName] = ?</property>
