                              description="The SQL command to be executed."
                              expressionType="Notify"
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">IF NOT EXISTS (SELECT 1 FROM dbo.Consultants WHERE FirstName = ?)
BEGIN
    INSERT INTO dbo.Consultants (FirstName) VALUES (?);
END</property>
